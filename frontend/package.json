{
  "name": "travel-assistant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LangGraph 智能出行助手前端：示例行程 + AI 规划 + Leaflet 路线地图",
  "scripts": {
    "dev": "vite",
    "build": "node check-source-paths.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:source-paths": "node check-source-paths.mjs",
    "typecheck": "node check-source-paths.mjs && tsc -b --force --pretty false",
    "stub": "node dev-stub/server.mjs",
    "verify:e2e": "node e2e/runner.mjs",
    "verify:e2e:malicious-base": "node e2e/malicious-base.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
