# ========================================
# 智能出行助手 - 环境变量配置
# ========================================
# 使用方法：复制本文件为 .env，再按需填入 Key。
# 所有 Key 留空即可启动：后端正常服务，可浏览内置的北京中轴线三日示例行程；
# 只有动态生成行程、真实地图路线、天气查询需要对应的 Key。

# 通义千问（DashScope）API Key：用于动态生成行程
# 留空时后端照常启动，示例行程可浏览，/chat 与行程生成接口返回 503 提示。
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 模型名称（可选，默认 qwen-plus）
MODEL_NAME=qwen-plus

# 高德地图 API Key：用于真实地图路线与坐标（可选）
# 注意：请使用高德控制台中「Web 服务」类型的 Key，不是 Web 端(JS API) Key。
# 用途：行程规划的地理编码、POI 检索、步行/驾车路线（restapi.amap.com），
#       以及 amap_server.py 提供的地图工具。
# 留空时站点坐标为 null，路段标记 unavailable，地图上用直线虚线示意。
# 获取地址: https://lbs.amap.com/
AMAP_API_KEY=

# OpenWeather API Key：仅天气查询工具（可选）
# 只影响 weather_server.py 的天气 MCP 工具；行程规划接口本身不查天气。
# 获取地址: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# 后端服务监听地址与端口
# 默认 127.0.0.1 只监听本机，适合本地体验；
# 需要局域网内其他设备访问时，自行把 API_HOST 改成 0.0.0.0。
API_HOST=127.0.0.1
API_PORT=8000
