# ========================================
# 智能出行助手 - 环境变量配置
# ========================================
# 将此文件复制为 .env 并填入真实的 API Key

# 通义千问 API Key (必填)
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 模型名称 (可选，默认 qwen-plus)
# MODEL_NAME=qwen-plus
MODEL_NAME=qwen-plus

# OpenWeather API Key (天气查询功能需要)
# 获取地址: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# 高德地图 API Key (可选，如果使用本地高德服务)
# 获取地址: https://lbs.amap.com/
AMAP_API_KEY=your-amap-api-key-here

# 服务端口配置
API_HOST=0.0.0.0
API_PORT=8000

# SSE 远程服务配置
SSE_HOST=0.0.0.0
SSE_PORT=8080
