# ========================================
# 智能出行助手 - 本机使用配置模板
# ========================================
# 首次使用：在仓库根目录（api_server.py 同级）复制本文件为 .env。
# 已有 .env 时请对照补充配置，不要覆盖自己填写的 Key；修改后重启后端。
# 真实生成和地图路线需要下方两项 Key；全部留空仍可启动并浏览内置示例。
# 网页 Open-Meteo 日天气、OSM/Overpass 资料候选与 OSM 底图均不需要 Key；
# Tavily 网页资料搜索不配 Key 也能启动，只是搜索返回固定 no_key 提示。
# Key 只配置在本机后端，不放进 frontend、导出文件或 Git 提交。

# [当前需要] 阿里云百炼（DashScope）模型 API Key
# 用于行程生成、单日/后段 AI 调整、聊天和 CLI；留空时相应能力不可用。
# 请使用华北2（北京）地域的 Key，并确认有 qwen3.8-flash 权限与可用额度。
# 这是模型 API Key，不是阿里云 AccessKey ID / AccessKey Secret。
# 获取地址: https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key
DASHSCOPE_API_KEY=

# 模型正式 ID；后端与两个 CLI 入口的默认值均为 qwen3.8-flash。
# 项目为该模型适配多模态接口，默认关闭额外思考；当前界面仍只接收文字。
# 已有 .env 或进程环境中的 MODEL_NAME 会覆盖代码默认值，请同步检查这一行。
# 模型说明: https://help.aliyun.com/zh/model-studio/qwen3-8-flash
MODEL_NAME=qwen3.8-flash

# [当前需要] 高德地图 Web 服务 API Key：用于真实地图路线与坐标
# 注意：请使用高德控制台中「Web 服务」类型的 Key，不是 Web 端(JS API) Key。
# 所需权限：地理编码、POI 搜索、路径规划2.0（v5 步行/驾车），以及对应配额。
# 同一 Key 也供 amap_server.py 地图工具使用；无需另配高德 JS API 安全密钥。
# 留空时新生成行程的真实坐标/导航降级：坐标与距离保持未知，不冒充导航。
# 获取地址: https://console.amap.com/
AMAP_API_KEY=

# [兼容保留，可留空] OpenWeather API Key
# 仅供 weather_server.py 旧天气 MCP 工具；Agent 是否调用由模型和工具可用性决定。
# 网页 GET /api/weather/day 使用 Open-Meteo，与此 Key 无关。
# 获取地址: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# [可选] Tavily Search API Key：网页资料搜索（前端「查网页资料」入口）
# 后端启动时（lifespan）读取；留空仍可启动，查询返回固定 no_key 安全提示、不发上游请求。
# 搜索结果是未核实的引擎摘要，不写行程/费用/本地保存；详见 docs/TAVILY_WEB_SOURCES.md。
# 获取地址: https://app.tavily.com/
TAVILY_API_KEY=

# 后端服务监听地址与端口：当前按本机自用，保留回环地址。
API_HOST=127.0.0.1
API_PORT=8000

# 可选超时配置（秒）：不填写时采用以下代码默认值。
# MCP_INIT_TIMEOUT=20
# TRIP_PLAN_TIMEOUT=180
# TRIP_REPLAN_TIMEOUT=90
# AMAP_TIMEOUT=6
# MAP_ENRICH_TIMEOUT=40
# MAP_REFRESH_TIMEOUT=20
# CHAT_TIMEOUT=120

# CORS 不设置时使用内置本机来源白名单；请不要取消注释后留空。
# 如需自定义，填写完整来源，逗号分隔；该列表会整体替换默认值。
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
